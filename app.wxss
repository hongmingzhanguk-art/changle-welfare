page {
  --primary: #6B5CFF;
  --primary-dark: #4C6FFF;
  --primary-light: #9B5CFF;
  --grad: linear-gradient(90deg, #4C6FFF 0%, #8B5CFF 100%);
  --grad-v: linear-gradient(180deg, #4C6FFF 0%, #8B5CFF 100%);
  --price: #FF2A2A;
  --bg: #F4F5F9;
  --card: #ffffff;
  --text: #1A1A1A;
  --sub: #8A8A99;
  --muted: #B4B4BE;
  --line: #F0F0F3;
  --tag-bg: #F0EBFF;
  --radius: 24rpx;
  --shadow: 0 8rpx 24rpx rgba(80, 70, 180, 0.06);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

view, text, image, navigator, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: inherit;
  font-size: inherit;
  border-radius: 0;
}
button::after {
  border: none;
}

.page {
  min-height: 100vh;
  background: var(--bg);
}

.card {
  background: #fff;
  border-radius: var(--radius);
}

.price {
  color: var(--price);
  font-weight: 600;
}
.price .yen {
  font-size: 0.72em;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #4C6FFF 0%, #8B5CFF 100%);
}

.btn-ghost {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: var(--primary);
  font-size: 30rpx;
  border-radius: 44rpx;
  border: 2rpx solid var(--primary);
  background: #fff;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.cart-fab {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B6CFF, #9B5CFF);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-fab-icon {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 6rpx 6rpx 8rpx 8rpx;
  position: relative;
}
.cart-fab-icon::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 4rpx;
  width: 14rpx;
  height: 10rpx;
  border: 3rpx solid #fff;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}
