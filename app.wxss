page {
  /* Color */
  --bg: #F4F5F9;
  --card: #ffffff;
  --fill: #F3F4F8;
  --text: #1A1A1A;
  --sub: #6E6E7A;
  --icon: #8A8A99;
  --line: #F0F0F3;
  --line-strong: #D0D0D6;
  --primary: #6B5CFF;
  --primary-dark: #4D42B8;
  --primary-light: #8B7CFF;
  --primary-soft: rgba(107, 92, 255, 0.16);
  --grad-start: #4C6FFF;
  --grad-end: #8B5CFF;
  --grad: linear-gradient(90deg, var(--grad-start) 0%, var(--grad-end) 100%);
  --grad-v: linear-gradient(180deg, var(--grad-start) 0%, var(--grad-end) 100%);
  --grad-diag: linear-gradient(135deg, var(--grad-start), var(--grad-end));
  --wash: #E6E0FF;
  --price: #FF2A2A;
  --danger: #FF3B30;
  --warn: #FF8A1A;
  --tag-bg: #F0EBFF;
  --on-inverse: #ffffff;
  --overlay: rgba(0, 0, 0, 0.45);
  --scrim: rgba(0, 0, 0, 0.35);

  /* Type — 4 purpose roles + price/hero (rpx; 2rpx ≈ 1pt) */
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 40rpx;
  --fs-price: 48rpx;
  --fs-hero: 64rpx;
  --fw-title: 600;
  --fw-display: 700;

  /* Space — 8rpx base */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --hit: 88rpx;
  --radius: 24rpx;
  --radius-pill: 44rpx;
  --shadow: 0 8rpx 24rpx rgba(80, 70, 180, 0.06);
  --shadow-bar: 0 -8rpx 24rpx rgba(32, 24, 72, 0.06);
  --shadow-cta: 0 8rpx 20rpx rgba(76, 111, 255, 0.28);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--fs-body);
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

view, text, image, navigator, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  line-height: inherit;
  font-size: inherit;
  border-radius: 0;
}
button::after {
  border: none;
}

.page {
  min-height: 100vh;
  background: var(--bg);
}

.deco-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}
.deco-front {
  position: relative;
  z-index: 1;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
}

.ph {
  color: var(--sub);
  font-size: var(--fs-body);
}

.price {
  color: var(--price);
  font-weight: var(--fw-title);
  font-size: var(--fs-title);
}
.price .yen {
  font-size: 0.72em;
}
.price.big {
  font-size: var(--fs-price);
  font-weight: var(--fw-display);
}

.btn-primary {
  height: var(--hit);
  min-height: var(--hit);
  line-height: var(--hit);
  text-align: center;
  color: var(--on-inverse);
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  letter-spacing: 1rpx;
  border-radius: var(--radius-pill);
  background: var(--grad);
  box-shadow: var(--shadow-cta);
}

.btn-ghost {
  height: var(--hit);
  min-height: var(--hit);
  line-height: var(--hit);
  text-align: center;
  color: var(--primary);
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--primary);
  background: var(--card);
}

.btn-on {
  opacity: 0.88;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

/* Visual mark 48rpx (24pt); hit box 88rpx */
.cart-fab {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  border-radius: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  flex-shrink: 0;
}
.cart-fab-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  z-index: 1;
}

.list-empty {
  width: 100%;
  padding: 96rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.list-empty-t {
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 40rpx;
}
.list-empty-s {
  margin-top: var(--space-1);
  font-size: var(--fs-caption);
  color: var(--sub);
  line-height: 32rpx;
}
