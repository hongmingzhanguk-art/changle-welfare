.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex;
  border-top: 1rpx solid #F2F2F5;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}
.txt {
  font-size: 20rpx;
  color: #B8B8B8;
}
.txt.on {
  color: #6B5CFF;
}
