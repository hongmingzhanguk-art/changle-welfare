<view class="tabbar">
  <view
    class="item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <image class="icon" src="{{selected === index ? item.active : item.icon}}" mode="aspectFit"></image>
    <text class="txt {{selected === index ? 'on' : ''}}">{{item.text}}</text>
  </view>
</view>
