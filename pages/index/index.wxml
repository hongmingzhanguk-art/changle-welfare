<view class="page home">
  <view class="hero">
    <image class="deco-bg hero-bg" src="{{bg.homeHero}}" mode="aspectFill"></image>
    <view class="deco-front" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-row">
        <image class="brand-mark" src="{{img['/images/brand-mark-white.png']}}" mode="aspectFit" aria-label="常乐福利"></image>
      </view>
      <view class="search-row">
        <view class="city" bindtap="goCity">
          <image class="pin" src="{{img['/images/icons/pin-white.png']}}" mode="aspectFit"></image>
          <text>{{city}}</text>
          <image class="caret" src="{{img['/images/icons/chevron-down-white.png']}}" mode="aspectFit"></image>
        </view>
        <view class="search-hit" bindtap="goSearch">
          <view class="search">
            <image class="sicon" src="{{img['/images/icons/search-white.png']}}" mode="aspectFit"></image>
            <text class="sph">请输入搜索关键词</text>
          </view>
        </view>
      </view>
      <view class="banner-wrap">
        <swiper class="banner" autoplay circular interval="4000">
          <swiper-item wx:for="{{banners}}" wx:key="id">
            <image class="banner-img" src="{{item.image}}" mode="aspectFill" bindtap="goDetail" data-id="{{item.productId}}"></image>
          </swiper-item>
        </swiper>
      </view>
    </view>
  </view>

  <view class="cats card">
    <view class="cat" wx:for="{{categories}}" wx:key="id" bindtap="goCate" data-id="{{item.id}}" data-name="{{item.name}}">
      <image class="cat-icon" src="{{item.icon}}" mode="aspectFill"></image>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <view class="section card movies-sec">
    <view class="sec-hd">
      <text class="sec-title">电影鉴赏</text>
    </view>
    <scroll-view scroll-x class="movies" enhanced show-scrollbar="{{false}}">
      <view class="movie" wx:for="{{movies}}" wx:key="id">
        <image class="poster" src="{{item.poster}}" mode="aspectFill"></image>
        <text class="mname">{{item.name}}</text>
        <view class="ticket-hit" bindtap="buyTicket" hover-class="btn-on" hover-stay-time="80">
          <image class="ticket" src="{{img['/images/ui/btn-ticket.png']}}" mode="aspectFit"></image>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="ops">
    <view class="op op-coupon" bindtap="goOps" data-t="生活卡券">
      <view class="op-hd">
        <text>生活卡券</text>
        <text class="more">›</text>
      </view>
      <image class="op-img" src="{{img['/images/ops/coupon.png']}}" mode="aspectFill"></image>
    </view>
    <view class="op op-gift" bindtap="goOps" data-t="节日礼包">
      <view class="op-hd">
        <text>节日礼包</text>
        <text class="more">›</text>
      </view>
      <image class="op-img" src="{{img['/images/ops/gift.png']}}" mode="aspectFill"></image>
    </view>
  </view>

  <view class="local card">
    <image class="deco-bg local-bg" src="{{bg.localLife}}" mode="aspectFill"></image>
    <view class="local-title deco-front">本地生活 应有尽有</view>
    <view class="brands deco-front">
      <view class="brand-item" wx:for="{{brands}}" wx:key="id" bindtap="goOps" data-t="{{item.name}}">
        <image class="brand-icon" src="{{item.icon}}" mode="aspectFill"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="popular card">
    <image class="deco-bg popular-bg" src="{{bg.popular}}" mode="aspectFill"></image>
    <view class="sec-hd deco-front">
      <view class="hot-title">
        <image class="fire-ic" src="{{img['/images/icons/fire.png']}}" mode="aspectFit"></image>
        <text>人气推荐</text>
      </view>
    </view>
    <scroll-view scroll-x class="pop-row deco-front" enhanced show-scrollbar="{{false}}">
      <view class="pop-left">
        <image class="pop-banner" src="{{img['/images/ops/popular-left.png']}}" mode="aspectFill"></image>
      </view>
      <view class="pop-item" wx:for="{{popular}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image src="{{item.image}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view
      class="tab {{tabId === item.id ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTab"
    >{{item.name}}</view>
  </scroll-view>

  <view class="grid">
    <view class="p-card" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="p-img" src="{{item.image}}" mode="aspectFill"></image>
      <view class="p-body">
        <view class="p-name ellipsis-2">{{item.title}}</view>
        <view class="p-foot">
          <text class="price"><text class="yen">¥</text>{{item.price}}</text>
          <view class="cart-fab" catchtap="addCart" data-id="{{item.id}}" hover-class="btn-on" hover-stay-time="80">
            <image class="cart-fab-icon" src="{{img['/images/ui/btn-cart.png']}}" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="tail">已经到底啦</view>
</view>
