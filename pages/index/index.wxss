.home {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.hero {
  position: relative;
  background: linear-gradient(180deg, var(--grad-start) 0%, var(--primary-light) 55%, var(--wash) 85%, var(--bg) 100%);
  padding-bottom: var(--space-3);
}
.hero-bg {
  height: 660rpx;
}

.nav-row {
  height: var(--hit);
  display: flex;
  align-items: center;
  padding: 0 var(--space-4);
}
.brand-mark {
  width: 144rpx;
  height: 44rpx;
}

.search-row {
  display: flex;
  align-items: center;
  padding: 0 var(--space-3) var(--space-3);
  gap: var(--space-2);
}
.city {
  display: flex;
  align-items: center;
  color: var(--on-inverse);
  font-size: var(--fs-body);
  flex-shrink: 0;
  min-height: var(--hit);
}
.pin {
  width: 20rpx;
  height: 28rpx;
  margin-right: var(--space-1);
}
.caret {
  width: 20rpx;
  height: 20rpx;
  margin-left: 4rpx;
}
.search-hit {
  flex: 1;
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.search {
  flex: 1;
  height: 68rpx;
  min-height: 68rpx;
  background: rgba(255,255,255,0.3);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
  border: 1rpx solid rgba(255,255,255,0.2);
}
.sicon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.sph { color: rgba(255,255,255,0.92); font-size: var(--fs-body); }

.banner-wrap {
  margin: 8rpx var(--space-3) 0;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(80,70,180,0.12);
}
.banner { height: 300rpx; }
.banner-img { width: 100%; height: 300rpx; }

.cats {
  margin: 0 var(--space-3) var(--space-3);
  padding: var(--space-3) var(--space-1) var(--space-1);
  display: flex;
  flex-wrap: wrap;
}
.cat {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-3);
  min-height: var(--hit);
}
.cat-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: var(--fill);
}
.cat-name {
  margin-top: 10rpx;
  font-size: var(--fs-caption);
  color: var(--text);
}

.section { margin: 0 var(--space-3) var(--space-3); padding: var(--space-4) 0 var(--space-3); }
.section.card.movies-sec {
  background: linear-gradient(180deg, #DBE9FF 0%, #ffffff 17.45%);
}
.sec-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 var(--space-3) var(--space-2);
}
.sec-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
}
.more { color: var(--icon); font-size: var(--fs-display); }

.movies {
  white-space: nowrap;
  padding: 0 var(--space-2);
}
.movie {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 176rpx;
  margin: 0 var(--space-1);
  vertical-align: top;
}
.poster {
  width: 176rpx;
  height: 248rpx;
  border-radius: var(--space-2);
  background: var(--fill);
}
.mname {
  font-size: var(--fs-caption);
  margin: 12rpx 0 10rpx;
  color: var(--text);
}
.ticket-hit {
  width: 100%;
  min-height: var(--hit);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ticket {
  width: 120rpx;
  height: 48rpx;
}

.ops {
  display: flex;
  gap: var(--space-2);
  margin: 0 var(--space-3) var(--space-3);
}
.op {
  flex: 1;
  border-radius: var(--radius);
  overflow: hidden;
  padding: var(--space-3) 20rpx 0;
  height: 396rpx;
}
.op-coupon { background: linear-gradient(180deg, #FFDBE4 0%, #ffffff 17.45%); }
.op-gift { background: linear-gradient(180deg, #FFDBFB 0%, #ffffff 17.45%); }
.op-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
}
.op-img {
  width: 300rpx;
  height: 300rpx;
  margin: 20rpx auto 0;
  border-radius: var(--space-2) var(--space-2) 0 0;
}

.local {
  position: relative;
  overflow: hidden;
  margin: 0 var(--space-3) var(--space-3);
  padding: var(--space-4) var(--space-2) var(--space-1);
  background: linear-gradient(180deg, #FFF3E4, var(--card) 50%);
}
.local-bg {
  height: 256rpx;
}
.local-title {
  text-align: center;
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  color: #732C2C;
  margin-bottom: var(--space-3);
}
.brands { display: flex; }
.brand-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--sub);
  min-height: var(--hit);
}
.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius);
  margin-bottom: 10rpx;
}

.popular {
  position: relative;
  overflow: hidden;
  margin: 0 var(--space-3) var(--space-3);
  padding: var(--space-3) 0 var(--space-2);
  background: linear-gradient(180deg, #DDF4FF, var(--card));
}
.popular-bg {
  height: 314rpx;
}
.hot-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  display: flex;
  align-items: center;
}
.fire-ic {
  width: 48rpx;
  height: 48rpx;
  margin-right: var(--space-1);
  flex-shrink: 0;
}
.pop-row { white-space: nowrap; padding: 0 var(--space-2); }
.pop-left, .pop-item {
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  margin-right: 12rpx;
}
.pop-left {
  width: 178rpx;
  height: 214rpx;
  border-radius: var(--space-2);
  overflow: hidden;
  background: #7EC8FF;
  position: relative;
}
.pop-banner { width: 178rpx; height: 214rpx; }
.pop-item {
  width: 180rpx;
  align-items: center;
  background: var(--card);
  border-radius: var(--space-2);
  padding: var(--space-1);
}
.pop-item image { width: 160rpx; height: 140rpx; }
.pop-item text { font-size: var(--fs-caption); margin-top: 6rpx; color: var(--text); }

.tabs {
  white-space: nowrap;
  padding: var(--space-1) var(--space-3) var(--space-2);
}
.tab {
  display: inline-block;
  margin-right: 36rpx;
  font-size: var(--fs-body);
  color: var(--sub);
  min-height: var(--hit);
  line-height: var(--hit);
  padding-bottom: var(--space-1);
}
.tab.on {
  color: var(--text);
  font-weight: var(--fw-title);
  font-size: var(--fs-title);
  position: relative;
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: var(--space-5);
  height: 6rpx;
  background: var(--primary);
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 var(--space-2);
}
.p-card {
  width: 50%;
  padding: var(--space-1);
}
.p-img {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: var(--card);
}
.p-body {
  background: var(--card);
  border-radius: 0 0 20rpx 20rpx;
  padding: var(--space-2) var(--space-2) var(--space-3);
}
.p-name {
  height: 80rpx;
  font-size: var(--fs-body);
  line-height: var(--space-5);
  color: var(--text);
}
.p-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.p-foot .price { font-size: var(--fs-title); }
.p-foot .yen { font-size: var(--fs-caption); }
.p-foot .cart-fab {
  margin: -16rpx -16rpx -16rpx 0;
}

.tail {
  text-align: center;
  color: var(--sub);
  font-size: var(--fs-caption);
  padding: var(--space-3) 0 var(--space-1);
}
