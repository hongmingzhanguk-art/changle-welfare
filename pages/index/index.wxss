.home {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F4F5F9;
}

.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #6A7BFF 0%, #8B82FF 55%, #C8C0FF 85%, #F4F5F9 100%);
  padding-bottom: 40rpx;
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}
.b1 { width: 360rpx; height: 360rpx; right: -80rpx; top: -40rpx; }
.b2 { width: 220rpx; height: 220rpx; left: -60rpx; top: 80rpx; background: rgba(180, 160, 255, 0.25); }

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.brand {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.search-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx 24rpx;
  gap: 16rpx;
}
.city {
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}
.pin {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 10rpx;
}
.caret { margin-left: 4rpx; font-size: 20rpx; opacity: 0.9; }
.search {
  flex: 1;
  height: 68rpx;
  background: rgba(255,255,255,0.28);
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255,255,255,0.35);
}
.sicon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid rgba(255,255,255,0.9);
  border-radius: 50%;
  position: relative;
  margin-right: 12rpx;
}
.sicon::after {
  content: '';
  position: absolute;
  width: 10rpx;
  height: 3rpx;
  background: rgba(255,255,255,0.9);
  right: -8rpx;
  bottom: -4rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}
.sph { color: rgba(255,255,255,0.85); font-size: 24rpx; }

.banner-wrap {
  margin: -8rpx 24rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(80,70,180,0.12);
}
.banner { height: 280rpx; }
.banner-img { width: 100%; height: 280rpx; }

.cats {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 8rpx 8rpx;
  display: flex;
  flex-wrap: wrap;
}
.cat {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.cat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f6f6f8;
}
.cat-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #333;
}

.section { margin: 0 24rpx 20rpx; padding: 24rpx 0 20rpx; }
.sec-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 16rpx;
}
.sec-title { font-size: 32rpx; font-weight: 700; }
.more { color: #C0C0C8; font-size: 36rpx; }

.movies {
  white-space: nowrap;
  padding: 0 16rpx;
}
.movie {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 176rpx;
  margin: 0 8rpx;
  vertical-align: top;
}
.poster {
  width: 176rpx;
  height: 248rpx;
  border-radius: 16rpx;
  background: #eee;
}
.mname {
  font-size: 24rpx;
  margin: 12rpx 0 10rpx;
  color: #222;
}
.ticket {
  width: 120rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  color: #fff;
  font-size: 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(90deg, #5B6CFF, #8B5CFF);
}

.ops {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 20rpx;
}
.op {
  flex: 1;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 20rpx 20rpx 0;
  height: 280rpx;
}
.op-coupon { background: linear-gradient(180deg, #FFE8E4, #fff); }
.op-gift { background: linear-gradient(180deg, #F3E8FF, #fff); }
.op-hd {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 700;
}
.op-img {
  width: 100%;
  height: 200rpx;
  margin-top: 8rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.local {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 16rpx 8rpx;
  background: linear-gradient(180deg, #FFF3E4, #fff 50%);
}
.local-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.brands { display: flex; }
.brand-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #555;
}
.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-bottom: 10rpx;
}

.popular {
  margin: 0 24rpx 12rpx;
  padding: 20rpx 0 16rpx;
  background: linear-gradient(180deg, #DDF4FF, #fff);
}
.hot-title { font-size: 32rpx; font-weight: 700; display: flex; align-items: center; }
.fire {
  font-size: 18rpx;
  color: #fff;
  background: linear-gradient(90deg, #FF7A3A, #FF3A3A);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}
.pop-row { white-space: nowrap; padding: 0 16rpx; }
.pop-left, .pop-item {
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  margin-right: 12rpx;
}
.pop-left {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #7EC8FF, #B6E8FF);
  position: relative;
}
.pop-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  z-index: 1;
  white-space: normal;
}
.pop-banner { width: 220rpx; height: 220rpx; }
.pop-item {
  width: 180rpx;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
}
.pop-item image { width: 160rpx; height: 140rpx; }
.pop-item text { font-size: 22rpx; margin-top: 6rpx; color: #333; }

.tabs {
  white-space: nowrap;
  padding: 8rpx 24rpx 16rpx;
}
.tab {
  display: inline-block;
  margin-right: 36rpx;
  font-size: 28rpx;
  color: #888;
  padding-bottom: 8rpx;
}
.tab.on {
  color: #1A1A1A;
  font-weight: 700;
  font-size: 32rpx;
  position: relative;
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #6B5CFF;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}
.p-card {
  width: 50%;
  padding: 8rpx;
}
.p-img {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx 20rpx 0 0;
  background: #fff;
}
.p-body {
  background: #fff;
  border-radius: 0 0 20rpx 20rpx;
  padding: 16rpx 16rpx 20rpx;
}
.p-name {
  height: 76rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #222;
}
.p-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.p-foot .price { font-size: 32rpx; }
.p-foot .yen { font-size: 22rpx; }

.tail {
  text-align: center;
  color: #C0C0C8;
  font-size: 22rpx;
  padding: 24rpx 0 8rpx;
}
