.cate-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  position: relative;
}
.top {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, var(--wash) 0%, var(--card) 100%);
  padding-bottom: var(--space-1);
}
.top-bg {
  height: 176rpx;
}
.nav-row {
  height: var(--hit);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nt { font-size: var(--fs-title); font-weight: var(--fw-title); }
.search-hit {
  margin: 0 var(--space-3) var(--space-2);
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.search {
  flex: 1;
  height: 68rpx;
  min-height: 68rpx;
  background: #EBEEF2;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
}
.sicon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.sph { color: var(--sub); font-size: var(--fs-body); }

.h-cats-row {
  display: flex;
  align-items: stretch;
  height: 160rpx;
  background: var(--card);
}
.h-cats {
  flex: 1;
  min-width: 0;
  height: 160rpx;
  white-space: nowrap;
  padding: var(--space-1) var(--space-2) 12rpx;
}
.h-cat {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  margin-right: var(--space-1);
  vertical-align: top;
  min-height: var(--hit);
}
.h-cat image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}
.h-cat.on image {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx var(--primary-soft);
}
.h-cat text { font-size: var(--fs-caption); margin-top: var(--space-1); color: var(--text); }
.h-all {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  min-width: 64rpx;
  min-height: 160rpx;
  height: 160rpx;
  color: var(--sub);
  font-size: 20rpx;
  background: var(--card);
  box-shadow: -8rpx 0 16rpx rgba(0, 0, 0, 0.06);
  z-index: 1;
}
.eq {
  width: 24rpx;
  height: 24rpx;
  margin-bottom: 6rpx;
}
.h-all-txt {
  line-height: 1.15;
  text-align: center;
}

.body {
  flex: 1;
  display: flex;
  min-height: 0;
  background: var(--bg);
}
.side {
  width: 176rpx;
  height: 100%;
  background: var(--fill);
}
.side-item {
  min-height: var(--hit);
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--sub);
  position: relative;
}
.side-item.on {
  background: var(--card);
  color: var(--primary);
  font-weight: var(--fw-title);
}
.side-item.on::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 6rpx;
  background: var(--primary);
  border-radius: 0 4rpx 4rpx 0;
}

.main {
  flex: 1;
  min-width: 0;
  background: var(--card);
  display: flex;
  flex-direction: column;
}
.sorts {
  display: flex;
  padding: var(--space-2) var(--space-3);
  gap: 48rpx;
}
.sort {
  font-size: var(--fs-body);
  color: var(--sub);
  padding-bottom: var(--space-1);
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.sort.on {
  color: var(--text);
  font-weight: var(--fw-display);
  position: relative;
}
.sort.on::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 16rpx;
  width: 48rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 4rpx;
}
.list { flex: 1; height: 0; padding: 0 var(--space-2) var(--space-3); }
.row {
  display: flex;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid var(--line);
}
.thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--space-2);
  background: var(--fill);
  flex-shrink: 0;
}
.info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-2);
  display: flex;
  flex-direction: column;
}
.name { font-size: var(--fs-body); line-height: var(--space-5); height: 80rpx; }
.tag {
  align-self: flex-start;
  margin-top: var(--space-1);
  font-size: var(--fs-caption);
  color: var(--primary);
  background: var(--tag-bg);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.row-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row-foot .price { font-size: var(--fs-title); }
.row-foot .cart-fab { margin: -16rpx 0; }

.all-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  top: 0;
  background: var(--scrim);
  z-index: 8;
  pointer-events: auto;
}
.body { position: relative; z-index: 1; }
.top { position: relative; z-index: 20; }
.all-inline {
  background: var(--card);
  border-radius: 0 0 var(--space-4) var(--space-4);
  padding: var(--space-1) var(--space-2) 0;
}
.all-title { font-size: var(--fs-title); font-weight: var(--fw-title); margin: var(--space-1) var(--space-1) var(--space-3); }
.all-grid {
  display: flex;
  flex-wrap: wrap;
}
.all-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-3);
  min-height: var(--hit);
}
.all-item image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}
.all-item.on image { border-color: var(--primary); }
.all-item text { font-size: var(--fs-caption); margin-top: var(--space-1); }
.fold {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: var(--fs-body);
  padding: var(--space-2) 0 28rpx;
  min-height: var(--hit);
  background: linear-gradient(180deg, var(--card), var(--wash));
  border-radius: 0 0 var(--space-4) var(--space-4);
}
.fold-caret {
  width: 20rpx;
  height: 12rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}
