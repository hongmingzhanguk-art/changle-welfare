.fb { min-height: 100vh; background: #F4F5F9; }
.card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}
.hd { font-size: 30rpx; font-weight: 700; display: flex; align-items: center; margin-bottom: 16rpx; }
.bar { width: 8rpx; height: 28rpx; background: #6B5CFF; border-radius: 4rpx; margin-right: 10rpx; }
.pick {
  background: #F4F5F9;
  border-radius: 16rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: #555;
}
.hint { color: #888; font-size: 24rpx; line-height: 1.6; margin-bottom: 16rpx; }
.area-wrap {
  background: #F4F5F9;
  border-radius: 16rpx;
  padding: 20rpx;
  position: relative;
}
textarea { width: 100%; height: 220rpx; font-size: 26rpx; }
.count { text-align: right; color: #B0B0B8; font-size: 22rpx; }
.btn-primary { margin-top: 28rpx; }
