.login {
  min-height: 100vh;
  background: #fff;
  position: relative;
  overflow: hidden;
}
.bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #EDE6FF 0%, #F7F3FF 28%, #ffffff 55%);
}
.c {
  position: absolute;
  border-radius: 50%;
}
.c1 {
  width: 360rpx; height: 360rpx;
  right: -80rpx; top: 80rpx;
  background: radial-gradient(circle, rgba(160,170,255,0.55), transparent 70%);
}
.c2 {
  width: 280rpx; height: 280rpx;
  left: -100rpx; top: 200rpx;
  background: radial-gradient(circle, rgba(150,140,255,0.4), transparent 70%);
}
.c3 {
  width: 200rpx; height: 200rpx;
  right: 80rpx; top: 40rpx;
  background: radial-gradient(circle, rgba(220,180,255,0.35), transparent 70%);
}
.center {
  position: relative;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  width: 168rpx;
  height: 168rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(90,80,180,0.12);
}
.name {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 800;
  font-style: italic;
}
.slogan {
  margin-top: 12rpx;
  color: #888;
  font-size: 26rpx;
}
.login-btn {
  width: 630rpx;
  margin-top: 72rpx;
}
.agree {
  width: 630rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: flex-start;
}
.dot {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #D0D0D6;
  border-radius: 50%;
  margin-right: 12rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}
.dot.on {
  border-color: #6B5CFF;
  background: #6B5CFF;
}
.agree-txt {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}
.link { color: #3B6BFF; }
