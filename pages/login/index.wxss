.login {
  min-height: 100vh;
  background: var(--card);
  position: relative;
  overflow: hidden;
}
.bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #EDE6FF 0%, #F7F3FF 28%, #ffffff 55%);
}
.c {
  position: absolute;
  border-radius: 50%;
}
.c1 {
  width: 360rpx; height: 360rpx;
  right: -80rpx; top: 80rpx;
  background: radial-gradient(circle, rgba(160,170,255,0.55), transparent 70%);
}
.c2 {
  width: 280rpx; height: 280rpx;
  left: -100rpx; top: 200rpx;
  background: radial-gradient(circle, rgba(150,140,255,0.4), transparent 70%);
}
.c3 {
  width: 200rpx; height: 200rpx;
  right: 80rpx; top: var(--space-5);
  background: radial-gradient(circle, rgba(220,180,255,0.35), transparent 70%);
}
.center {
  position: relative;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  width: 168rpx;
  height: 168rpx;
  border-radius: 36rpx;
  background: var(--card);
  box-shadow: 0 12rpx 32rpx rgba(90,80,180,0.12);
}
.name {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 800;
  font-style: italic;
}
.slogan {
  margin-top: 12rpx;
  color: var(--sub);
  font-size: var(--fs-body);
}
.login-btn {
  width: 630rpx;
  margin-top: 72rpx;
}
.agree {
  width: 630rpx;
  margin-top: var(--space-4);
  display: flex;
  align-items: flex-start;
}
.dot {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  border: none;
  border-radius: 0;
  margin: -28rpx 0 -28rpx -28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: transparent;
}
.dot::before {
  content: '';
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line-strong);
  box-sizing: border-box;
}
.dot.on {
  border: none;
  background: transparent;
}
.dot.on::before {
  border-color: var(--primary);
  background: var(--primary);
}
.agree-txt {
  font-size: var(--fs-caption);
  color: var(--sub);
  line-height: 1.6;
  padding-top: 8rpx;
}
.link { color: var(--primary); }
