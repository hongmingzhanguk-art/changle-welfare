.login {
  min-height: 100vh;
  background: var(--bg);
  position: relative;
  overflow: hidden;
}
.bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, var(--wash) 0%, var(--bg) 48%);
  pointer-events: none;
  overflow: hidden;
}
.bg-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 760rpx;
}

.stage {
  position: relative;
  padding: 220rpx 50rpx 0;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  width: 230rpx;
  height: 230rpx;
}
.name-mark {
  margin-top: 40rpx;
  width: 230rpx;
  height: 70rpx;
}
.slogan {
  margin-top: 24rpx;
  color: var(--sub);
  font-size: var(--fs-body);
  line-height: 1;
}

.actions {
  margin-top: 100rpx;
}
.login-btn {
  width: 650rpx;
  height: 100rpx;
  min-height: 100rpx;
}
.login-btn-img {
  width: 650rpx;
  height: 100rpx;
}
.agree {
  margin-top: 40rpx;
  display: flex;
  align-items: flex-start;
}
.dot {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  margin: -28rpx -16rpx -28rpx -28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: transparent;
}
.dot::before {
  content: '';
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line-strong);
  box-sizing: border-box;
}
.dot.on::before {
  border-color: var(--primary);
  background: var(--primary);
}
.dot.on::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 14rpx;
  margin-left: -5rpx;
  margin-top: -10rpx;
  border: 3rpx solid var(--on-inverse);
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
  box-sizing: border-box;
}
.agree-txt {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--sub);
  line-height: 1.5;
  padding-top: 4rpx;
}
.link { color: var(--primary); }
