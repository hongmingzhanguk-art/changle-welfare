<view class="page login">
  <view class="bg">
    <image class="bg-img" src="{{bg.loginHero}}" mode="aspectFill"></image>
  </view>
  <nav-bar title="登录" background="transparent"></nav-bar>
  <view class="stage">
    <view class="brand">
      <image class="logo" src="{{img['/images/ui/login-logo.png']}}" mode="aspectFit"></image>
      <image class="name-mark" src="{{img['/images/brand-mark-dark.png']}}" mode="aspectFit" aria-label="常乐福利"></image>
      <view class="slogan">福利不等待，常乐购精彩</view>
    </view>
    <view class="actions">
      <view class="login-btn" bindtap="login" hover-class="btn-on" hover-stay-time="80">
        <image class="login-btn-img" src="{{img['/images/ui/btn-login.png']}}" mode="scaleToFill"></image>
      </view>
      <view class="agree" bindtap="toggle">
        <view class="dot {{agreed ? 'on' : ''}}"></view>
        <view class="agree-txt">
          我已阅读并同意
          <text class="link" catchtap="openDoc" data-t="常乐隐私政策">《常乐隐私政策》</text>
          <text class="link" catchtap="openDoc" data-t="用户协议">《用户协议》</text>
          <text class="link" catchtap="openDoc" data-t="风控规则确认协议">《风控规则确认协议》</text>
        </view>
      </view>
    </view>
  </view>
</view>
