.cart-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: #F4F5F9;
  min-height: 100vh;
}
.top {
  background: linear-gradient(180deg, #E4DEFF 0%, #F4F5F9 100%);
  padding-bottom: 8rpx;
}
.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nt { font-size: 40rpx; font-weight: 700; }
.addr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 16rpx;
}
.addr { display: flex; align-items: center; color: #6B5CFF; font-size: 26rpx; }
.pin {
  width: 16rpx; height: 16rpx;
  border: 3rpx solid #6B5CFF;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 10rpx;
}
.caret { margin-left: 6rpx; }
.manage { color: #666; font-size: 26rpx; }

.ck {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #D0D0D6;
  flex-shrink: 0;
}
.ck.on {
  border-color: #6B5CFF;
  background: #6B5CFF;
  position: relative;
}
.ck.on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 8rpx;
  height: 16rpx;
  border: 3rpx solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

.empty {
  padding: 40rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #EFEAFF, #F7F5FF);
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-cart {
  width: 80rpx;
  height: 64rpx;
  border: 6rpx solid #C4B8FF;
  border-radius: 12rpx 12rpx 16rpx 16rpx;
  position: relative;
}
.empty-cart::before {
  content: '';
  position: absolute;
  top: -28rpx;
  left: 12rpx;
  width: 40rpx;
  height: 28rpx;
  border: 6rpx solid #C4B8FF;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}
.empty-t { margin-top: 24rpx; font-size: 32rpx; font-weight: 600; }
.empty-s { margin-top: 8rpx; color: #999; font-size: 24rpx; }
.empty-btn { width: 240rpx; margin-top: 28rpx; }

.shop {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 20rpx 8rpx;
  overflow: hidden;
}
.shop-hd { display: flex; align-items: center; margin-bottom: 12rpx; }
.shop-logo {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; margin: 0 10rpx;
  background: linear-gradient(135deg, #FF5A3C, #FF8A3C);
}
.shop-logo.s1 { background: linear-gradient(135deg, #FF3C5A, #FF6A3C); }
.shop-name { font-size: 28rpx; font-weight: 600; }

.item-wrap { overflow: hidden; }
.marea {
  width: 100%;
  height: 180rpx;
  overflow: hidden;
}
.mview {
  width: 942rpx;
  height: 180rpx;
  display: flex;
}
.item {
  width: 702rpx;
  flex-shrink: 0;
  padding: 12rpx 8rpx 12rpx 0;
  display: flex;
  align-items: center;
  background: #fff;
}
.thumb {
  width: 140rpx; height: 140rpx; border-radius: 16rpx; margin: 0 16rpx;
  background: #f6f6f6; border: 1rpx solid #F0F0F3;
}
.meta { flex: 1; min-width: 0; }
.name { font-size: 28rpx; }
.spec { color: #999; font-size: 22rpx; margin: 8rpx 0; }
.iprice { color: #FF2A2A; font-size: 30rpx; font-weight: 700; }
.qty { color: #999; font-size: 24rpx; margin-left: 8rpx; }
.actions { display: flex; width: 240rpx; height: 180rpx; }
.act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  writing-mode: horizontal-tb;
}
.fav { background: #FF8A1A; }
.del { background: #FF3B30; }

.guess-title {
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx 32rpx 12rpx;
  position: relative;
  z-index: 2;
  background: #F4F5F9;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx 24rpx;
  position: relative;
  z-index: 1;
}
.p-card { width: 50%; padding: 8rpx; }
.p-img { width: 100%; height: 340rpx; border-radius: 20rpx 20rpx 0 0; background: #fff; }
.p-body { background: #fff; border-radius: 0 0 20rpx 20rpx; padding: 16rpx 16rpx 20rpx; }
.p-name { height: 76rpx; font-size: 26rpx; line-height: 38rpx; }
.p-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.p-foot .price { font-size: 32rpx; }
.tail-space { height: 20rpx; }

.bar {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
  z-index: 20;
}
.all-txt { margin-left: 10rpx; font-size: 26rpx; color: #666; }
.sum { flex: 1; text-align: right; margin-right: 16rpx; font-size: 26rpx; }
.sum .price { font-size: 32rpx; }
.pay {
  width: 168rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #fff;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #4C6FFF, #8B5CFF);
  font-size: 28rpx;
}
