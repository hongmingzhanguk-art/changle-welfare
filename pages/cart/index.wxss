.cart-page {
  padding-bottom: calc(248rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  min-height: 100vh;
}
.top {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, var(--wash) 0%, var(--bg) 100%);
  padding-bottom: var(--space-1);
}
.top-bg {
  height: 500rpx;
}
.nav-row {
  height: var(--hit);
  display: flex;
  align-items: center;
  padding: 0 var(--space-4);
}
.nt {
  font-size: var(--fs-display);
  font-weight: var(--fw-display);
}
.addr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-1) var(--space-4) var(--space-2);
}
.addr {
  display: flex;
  align-items: center;
  color: #5F687E;
  font-size: var(--fs-body);
  min-height: var(--hit);
  flex: 1;
  min-width: 0;
}
.addr-txt {
  flex: 1;
  min-width: 0;
}
.pin {
  width: 20rpx;
  height: 28rpx;
  margin-right: 10rpx;
}
.caret-ic {
  width: 16rpx;
  height: 32rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}
.manage {
  color: #18191A;
  font-size: var(--fs-body);
  min-width: var(--hit);
  min-height: var(--hit);
  padding: var(--space-3) 0 var(--space-3) var(--space-2);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Visual 36rpx; hit 88rpx */
.ck {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  border: none;
  border-radius: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: 0;
}
.ck::before {
  content: '';
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line-strong);
  box-sizing: border-box;
}
.ck.on::before {
  border-color: var(--primary);
  background: var(--primary);
}
.ck-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
}
.ck.on .ck-mark {
  opacity: 1;
}

.empty {
  padding: var(--space-5) 0 var(--space-3);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-illust {
  width: 230rpx;
  height: 230rpx;
}
.empty-t {
  margin-top: var(--space-3);
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
}
.empty-s {
  margin-top: var(--space-1);
  color: var(--sub);
  font-size: var(--fs-caption);
}
.empty-btn { width: 240rpx; margin-top: 28rpx; }

.shop {
  margin: var(--space-2) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3) 0 var(--space-1);
  overflow: hidden;
}
.shop-hd {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 0 var(--space-3) 0 var(--space-1);
}
.shop-logo {
  width: 36rpx; height: 36rpx; border-radius: var(--space-1); margin: 0 10rpx;
}
.shop-name { font-size: var(--fs-body); font-weight: var(--fw-title); }

.item-wrap { overflow: hidden; }
.marea {
  width: 100%;
  height: 180rpx;
  overflow: hidden;
}
.mview {
  width: calc(100% + 240rpx);
  height: 180rpx;
  display: flex;
}
.item {
  width: calc(100% - 240rpx);
  flex-shrink: 0;
  padding: 12rpx var(--space-1);
  display: flex;
  align-items: center;
  background: var(--card);
}
.prod {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.thumb {
  width: 140rpx; height: 140rpx; border-radius: var(--space-2); margin: 0 var(--space-2);
  background: var(--fill); border: 1rpx solid var(--line);
}
.meta { flex: 1; min-width: 0; }
.name { font-size: var(--fs-body); }
.spec { color: var(--sub); font-size: var(--fs-caption); margin: var(--space-1) 0; }
.iprice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -20rpx -16rpx -20rpx 0;
}
.iprice { color: var(--price); font-size: var(--fs-title); font-weight: var(--fw-display); }
.stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.sbtn {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sbtn-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--space-1);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  color: var(--sub);
}
.snum {
  min-width: 40rpx;
  text-align: center;
  font-size: var(--fs-body);
}
.actions {
  display: flex;
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
}
.act {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  color: var(--on-inverse);
  font-size: var(--fs-caption);
}
.act-ic { width: 32rpx; height: 32rpx; }
.fav { background: var(--warn); }
.del { background: var(--danger); }

.guess-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  padding: var(--space-4) var(--space-4) 12rpx;
  position: relative;
  z-index: 2;
  background: var(--bg);
}
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 var(--space-2) var(--space-3);
  position: relative;
  z-index: 1;
}
.p-card { width: 50%; padding: var(--space-1); }
.p-img { width: 100%; height: 340rpx; border-radius: 20rpx 20rpx 0 0; background: var(--card); }
.p-body { background: var(--card); border-radius: 0 0 20rpx 20rpx; padding: var(--space-2) var(--space-2) var(--space-3); }
.p-name { height: 80rpx; font-size: var(--fs-body); line-height: var(--space-5); }
.p-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.p-foot .price { font-size: var(--fs-title); }
.p-foot .cart-fab { margin: -16rpx -16rpx -16rpx 0; }
.tail-space { height: var(--space-3); }

.bar {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
  box-shadow: var(--shadow-bar);
  z-index: 20;
}
.bar .ck { margin: 0; }
.all-txt { margin-left: 4rpx; font-size: var(--fs-body); color: var(--sub); }
.sum { flex: 1; text-align: right; margin-right: var(--space-2); font-size: var(--fs-body); }
.sum .price { font-size: var(--fs-title); }
.pay {
  min-width: 160rpx;
  min-height: 72rpx;
  height: 72rpx;
  padding: 0 var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--on-inverse);
  border-radius: var(--radius-pill);
  background: var(--grad);
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-cta);
}
