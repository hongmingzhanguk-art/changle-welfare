.ad { min-height: 100vh; background: var(--bg); }
.card {
  margin: var(--space-2) var(--space-3); background: var(--card); border-radius: var(--radius); padding: 28rpx;
  min-height: var(--hit);
}
.who { font-size: var(--fs-title); font-weight: var(--fw-title); }
.def {
  margin-left: 12rpx; font-size: 20rpx; color: var(--primary);
  background: var(--tag-bg); padding: 2rpx 10rpx; border-radius: 6rpx; font-weight: 400;
}
.full { color: var(--sub); font-size: var(--fs-caption); margin-top: 10rpx; }
.add { margin: 48rpx 48rpx 0; }
