.wel {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8E4FF 0%, var(--bg) 220rpx);
  padding-bottom: var(--space-5);
}
.card {
  margin: var(--space-2) var(--space-3);
  border-radius: 28rpx;
  padding: var(--space-4);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.card.purple { background: linear-gradient(135deg, #7B5CFF, #5B6CFF 60%, #8B6CFF); }
.card.pink { background: linear-gradient(135deg, #E85CFF, #FF6A8A 70%, #FF8A5C); }
.row1 { display: flex; justify-content: space-between; font-size: var(--fs-body); }
.face { opacity: 0.85; font-size: var(--fs-caption); }
.bal { text-align: center; font-size: 64rpx; font-weight: var(--fw-display); margin-top: var(--space-3); }
.sub { text-align: center; font-size: var(--fs-caption); opacity: 0.85; }
.row2 { display: flex; justify-content: space-between; align-items: flex-end; margin-top: var(--space-4); font-size: var(--fs-caption); opacity: 0.95; }
.cvt {
  background: rgba(255,255,255,0.22);
  padding: 0 var(--space-3);
  min-height: var(--hit);
  border-radius: var(--radius);
  font-size: var(--fs-caption);
  display: flex;
  align-items: center;
  gap: var(--space-1);
}
.cvt-ic { width: 28rpx; height: 28rpx; }
.copy { width: 28rpx; height: 28rpx; margin-left: var(--space-1); display: inline-block; vertical-align: middle; }
.rules {
  margin: var(--space-2) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3);
}
.rt { font-size: var(--fs-title); font-weight: var(--fw-title); display: flex; align-items: center; margin-bottom: var(--space-2); }
.bar { width: var(--space-1); height: 28rpx; background: var(--primary); border-radius: 4rpx; margin-right: 10rpx; }
.rb { color: var(--sub); font-size: var(--fs-body); line-height: 1.7; }
