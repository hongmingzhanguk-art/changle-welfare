.wel {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--wash) 0%, var(--bg) 220rpx);
  padding-bottom: var(--space-5);
}
.wel-bg {
  width: 100%;
}
.card {
  margin: var(--space-2) var(--space-3);
  border-radius: 24rpx;
  padding: 0;
  color: var(--on-inverse);
  position: relative;
  overflow: hidden;
  height: 380rpx;
  background: #8D6BFF;
}
.card.pink {
  background: #EE74B2;
}
.card-face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 380rpx;
  z-index: 0;
}
.card-body {
  position: relative;
  z-index: 1;
  height: 380rpx;
  padding: 32rpx 30rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cname {
  font-size: 36rpx;
  font-weight: 400;
  line-height: 36rpx;
}
.face {
  font-size: 32rpx;
  line-height: 32rpx;
  opacity: 0.92;
}
.bal {
  text-align: center;
  font-size: 60rpx;
  font-weight: 400;
  line-height: 60rpx;
  margin-top: 40rpx;
}
.sub {
  text-align: center;
  font-size: 28rpx;
  line-height: 28rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}
.row2 {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: auto;
  font-size: 24rpx;
  line-height: 1.5;
}
.meta-line {
  display: flex;
  align-items: center;
}
.copy {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.cvt {
  background: rgba(255, 255, 255, 0.2);
  padding: 0 20rpx;
  width: 144rpx;
  height: 68rpx;
  min-height: 68rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}
.cvt-ic { width: 28rpx; height: 28rpx; }
.rules {
  margin: var(--space-2) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3);
}
.rt { font-size: var(--fs-title); font-weight: var(--fw-title); display: flex; align-items: center; margin-bottom: var(--space-2); }
.bar { width: var(--space-1); height: 28rpx; background: var(--primary); border-radius: 4rpx; margin-right: 10rpx; }
.rb { color: var(--sub); font-size: var(--fs-body); line-height: 1.7; }
