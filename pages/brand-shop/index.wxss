.shop {
  min-height: 100vh;
  background: #F5F6F7;
  padding-bottom: 40rpx;
}
.sorts {
  background: #ffffff;
  display: flex;
  padding: 60rpx 0 26rpx;
}
.st {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  padding-bottom: 8rpx;
  line-height: 28rpx;
}
.st.on {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  line-height: 32rpx;
}
.st.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 64rpx;
  height: 12rpx;
  margin-left: -32rpx;
  background: linear-gradient(180deg, #5F9CFF 0%, #4089FF 100%);
}
.scaret {
  width: 18rpx;
  height: 20rpx;
  margin-left: 16rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 26rpx 24rpx;
  gap: 26rpx;
}
.p-card {
  width: 338rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}
.p-img {
  width: 338rpx;
  height: 360rpx;
  background: #F7F7F7;
}
.p-body { padding: 24rpx 26rpx 30rpx; }
.p-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  line-height: 36rpx;
}
.p-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.tag {
  height: 40rpx;
  padding: 0 10rpx;
  border: 1rpx solid #FD3F3F;
  border-radius: 8rpx;
  color: #FD3F3F;
  font-size: 20rpx;
  display: flex;
  align-items: center;
}
.p-sold {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #808080;
}
.p-foot {
  display: flex;
  align-items: baseline;
  margin-top: 30rpx;
  gap: 12rpx;
}
.price {
  color: #EB0000;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
}
.yen { font-size: 20rpx; }
.origin {
  font-size: 20rpx;
  color: #A6A6A6;
  text-decoration: line-through;
  line-height: 20rpx;
}
