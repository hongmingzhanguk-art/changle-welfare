.order {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F4F5F9;
  min-height: 100vh;
}
.card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}
.addr { display: flex; align-items: center; position: relative; padding-bottom: 32rpx; }
.addr-ic {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #6B5CFF; margin-right: 16rpx; flex-shrink: 0;
}
.addr-info { flex: 1; min-width: 0; }
.who { font-size: 30rpx; font-weight: 600; }
.full { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.arrow { color: #C8C8D0; font-size: 32rpx; }
.stripe {
  position: absolute;
  left: 0; right: 0; bottom: 0; height: 8rpx;
  background: repeating-linear-gradient(90deg, #FF5A5A 0 24rpx, #4C8DFF 24rpx 48rpx, #fff 48rpx 56rpx);
}

.wh { font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.g { display: flex; padding: 16rpx 0; }
.g image { width: 140rpx; height: 140rpx; border-radius: 16rpx; background: #f6f6f6; }
.ginfo { flex: 1; margin-left: 16rpx; min-width: 0; }
.gt { font-size: 28rpx; }
.tag {
  display: inline-block;
  background: #FF3B30; color: #fff;
  font-size: 18rpx; padding: 0 6rpx; border-radius: 4rpx; margin-right: 8rpx;
}
.gs { color: #999; font-size: 22rpx; margin: 10rpx 0; }
.gf { display: flex; justify-content: space-between; }
.gf .price { font-size: 30rpx; }
.gq { color: #999; }

.pay-title { padding: 8rpx 32rpx; font-size: 30rpx; font-weight: 700; }
.pay-item { display: flex; align-items: center; padding: 16rpx 0; }
.pic {
  width: 48rpx; height: 48rpx; border-radius: 12rpx;
  margin-right: 16rpx; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx;
}
.pic.star { background: linear-gradient(135deg, #FFC107, #FF9800); }
.pic.wx { background: #22C55E; font-size: 22rpx; }
.ptxt { flex: 1; }
.pn { font-size: 28rpx; font-weight: 600; }
.need { font-weight: 400; margin-left: 12rpx; }
.radio {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid #D0D0D6;
}
.radio.on {
  border-color: #6B5CFF; background: #6B5CFF;
  box-shadow: inset 0 0 0 6rpx #fff;
}
.balance {
  background: #F4F5F9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  color: #888;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  display: flex; align-items: center;
  padding-left: 32rpx; padding-right: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.sum { flex: 1; font-size: 26rpx; }
.sum .price { font-size: 36rpx; }
.pay-btn {
  width: 220rpx; height: 80rpx; line-height: 80rpx;
  text-align: center; color: #fff; border-radius: 40rpx;
  background: linear-gradient(90deg, #4C6FFF, #8B5CFF);
}

.cfm { text-align: left; }
.cl { color: #888; font-size: 26rpx; margin-bottom: 8rpx; }
.cv { font-size: 28rpx; color: #222; margin-bottom: 8rpx; }
.div { height: 1rpx; background: #EEE; margin: 16rpx 0; }
.price.big { font-size: 36rpx; }
