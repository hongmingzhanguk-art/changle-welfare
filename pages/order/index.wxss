.order {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  min-height: 100vh;
}
.card {
  margin: var(--space-2) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3);
}
.addr { display: flex; align-items: center; position: relative; padding-bottom: var(--space-4); min-height: var(--hit); }
.addr-ic {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  margin-right: var(--space-2); flex-shrink: 0;
}
.addr-info { flex: 1; min-width: 0; }
.who { font-size: var(--fs-title); font-weight: var(--fw-title); }
.full { font-size: var(--fs-caption); color: var(--sub); margin-top: var(--space-1); }
.arrow { color: var(--icon); font-size: var(--fs-title); }
.stripe {
  position: absolute;
  left: 0; right: 0; bottom: 0; height: var(--space-1);
  background: repeating-linear-gradient(90deg, #FF5A5A 0 24rpx, #4C8DFF 24rpx 48rpx, #fff 48rpx 56rpx);
}

.wh { font-size: var(--fs-body); font-weight: var(--fw-title); margin-bottom: var(--space-2); display: flex; align-items: center; }
.wh-ic { width: 32rpx; height: 32rpx; margin-right: var(--space-1); }
.g { display: flex; padding: var(--space-2) 0; }
.g image { width: 140rpx; height: 140rpx; border-radius: var(--space-2); background: #f6f6f6; }
.ginfo { flex: 1; margin-left: var(--space-2); min-width: 0; }
.gt { font-size: var(--fs-body); }
.tag {
  display: inline-block;
  background: var(--danger); color: #fff;
  font-size: 18rpx; padding: 0 6rpx; border-radius: 4rpx; margin-right: var(--space-1);
}
.gs { color: var(--sub); font-size: var(--fs-caption); margin: 10rpx 0; }
.gf { display: flex; justify-content: space-between; }
.gf .price { font-size: var(--fs-title); }
.gq { color: var(--sub); }

.pay-title { padding: var(--space-4) var(--space-4) var(--space-2); font-size: var(--fs-title); font-weight: var(--fw-title); }
.pay-item { display: flex; align-items: center; padding: var(--space-1) 0; min-height: var(--hit); }
.pic {
  width: 48rpx; height: 48rpx; border-radius: 12rpx;
  margin-right: var(--space-2); flex-shrink: 0;
}
.ptxt { flex: 1; }
.pn { font-size: var(--fs-body); font-weight: var(--fw-title); }
.need { font-weight: 400; margin-left: 12rpx; }
.radio {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  border: none;
  border-radius: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin: -26rpx -26rpx -26rpx 0;
}
.radio::before {
  content: '';
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line-strong);
  box-sizing: border-box;
}
.radio.on {
  border: none;
  background: transparent;
  box-shadow: none;
}
.radio.on::before {
  border-color: var(--primary);
  background: var(--primary);
  box-shadow: inset 0 0 0 6rpx #fff;
}
.balance {
  background: var(--bg);
  border-radius: 12rpx;
  padding: var(--space-2) var(--space-3);
  color: var(--sub);
  font-size: var(--fs-caption);
  margin-bottom: var(--space-1);
}

.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: calc(110rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--card);
  display: flex; align-items: center;
  padding-left: var(--space-4); padding-right: var(--space-3);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.sum { flex: 1; font-size: var(--fs-body); }
.sum .price { font-size: var(--fs-display); }
.pay-btn {
  min-width: 220rpx;
  min-height: var(--hit);
  height: var(--hit);
  padding: 0 var(--space-4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  border-radius: 44rpx;
  background: var(--grad);
  font-size: var(--fs-body);
}
.pay-btn.dim { opacity: 0.45; }

.cfm { text-align: left; }
.cl { color: var(--sub); font-size: var(--fs-body); margin-bottom: var(--space-1); }
.cv { font-size: var(--fs-body); color: var(--text); margin-bottom: var(--space-1); }
.div { height: 1rpx; background: #EEE; margin: var(--space-2) 0; }
.price.big { font-size: var(--fs-display); }
