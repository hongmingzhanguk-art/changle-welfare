.co {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: #F5F6F7;
  min-height: 100vh;
}
.card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
}
.addr {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 32rpx;
  position: relative;
  min-height: 144rpx;
  overflow: hidden;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.addr-info { flex: 1; min-width: 0; }
.who {
  font-size: 32rpx;
  color: #1A1A1A;
  line-height: 32rpx;
}
.full {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7A7F8D;
}
.chev {
  width: 12rpx;
  height: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.chev.sm { width: 12rpx; height: 24rpx; margin-left: 8rpx; }
.stripe {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  width: 100%;
}

.goods { padding: 24rpx; }
.shop {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}
.house {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}
.g { display: flex; }
.gimg {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F0F1F5;
  flex-shrink: 0;
}
.ginfo { flex: 1; margin-left: 20rpx; min-width: 0; }
.gt {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
}
.gs {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7A7F8D;
}
.gf {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.gprice {
  color: #EB0000;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 36rpx;
}
.gprice .yen { font-size: 28rpx; }
.gq { font-size: 24rpx; color: #000000; }

.row {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  margin-top: 8rpx;
}
.rk {
  font-size: 28rpx;
  color: #1A1A1A;
  flex-shrink: 0;
}
.ships {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.ship {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1A1A1A;
  min-height: var(--hit);
}
.radio {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.rv {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1A1A1A;
}
.rv.muted { color: #7A7F8D; }
.ph { color: #C0C0C0; }
.remark input,
.rmk {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1A1A1A;
  margin-left: 24rpx;
}

.pay-title {
  padding: 8rpx 24rpx 16rpx;
  font-size: 32rpx;
  color: #000000;
  line-height: 32rpx;
}
.pay { padding: 8rpx 24rpx 16rpx; }
.pay-item {
  display: flex;
  align-items: center;
  min-height: var(--hit);
}
.pic {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ptxt { flex: 1; display: flex; align-items: center; }
.pn { font-size: 28rpx; color: #1A1A1A; }
.need {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #7A7F8D;
}
.amt { color: #EB0000; font-weight: 500; }
.balance {
  height: 64rpx;
  margin: 0 0 8rpx 56rpx;
  background: #E6EAF3;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #7A7F8D;
}
.bal { color: #525969; }

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(160rpx + env(safe-area-inset-bottom));
  padding: 20rpx 24rpx env(safe-area-inset-bottom);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -8rpx 24rpx rgba(32, 24, 72, 0.06);
}
.sum {
  font-size: 28rpx;
  color: #17181A;
}
.sum-price {
  color: #EB0000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}
.sum-price .yen { font-size: 24rpx; }
.unit { font-size: 24rpx; color: #7A7F8D; }
.pay-btn {
  width: 200rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(90deg, #A680FF 0%, #3B35FF 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-on { opacity: 0.88; }
