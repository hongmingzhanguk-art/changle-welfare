.bind {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--wash) 0%, var(--bg) 240rpx);
}
.illus { margin: var(--space-1) var(--space-3) 0; border-radius: var(--radius); overflow: hidden; }
.illus image { width: 100%; }
.card {
  margin: var(--space-3) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx var(--space-3) 36rpx;
}
.hd { font-size: var(--fs-title); font-weight: var(--fw-title); display: flex; align-items: center; }
.bar { width: var(--space-1); height: 28rpx; background: var(--primary); border-radius: 4rpx; margin-right: 10rpx; }
.tip { color: var(--sub); font-size: var(--fs-caption); margin: var(--space-2) 0 var(--space-3); }
.field {
  background: var(--fill);
  border-radius: var(--space-2);
  height: var(--hit);
  min-height: var(--hit);
  display: flex;
  align-items: center;
  padding: 0 var(--space-3);
  margin-bottom: var(--space-2);
  font-size: var(--fs-body);
}
.field text { width: 80rpx; color: var(--text); }
.field input { flex: 1; font-size: var(--fs-body); color: var(--text); }
.btn-primary { margin-top: var(--space-2); }
