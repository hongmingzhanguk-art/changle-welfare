<view class="page detail">
  <view class="nav {{sticky ? 'solid' : ''}}" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner">
      <view class="circle" bindtap="onBack"><view class="arrow"></view></view>
      <view class="tabs" wx:if="{{sticky}}">
        <view class="dt {{tab==='goods'?'on':''}}" data-tab="goods" bindtap="switchTab">商品</view>
        <view class="dt {{tab==='rec'?'on':''}}" data-tab="rec" bindtap="switchTab">推荐</view>
        <view class="dt {{tab==='desc'?'on':''}}" data-tab="desc" bindtap="switchTab">详情</view>
      </view>
    </view>
  </view>

  <swiper class="gallery" indicator-dots circular>
    <swiper-item wx:for="{{product.images || [product.image]}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFit" class="gimg"></image>
    </swiper-item>
  </swiper>

  <view class="info card">
    <view class="title">
      <text class="store-tag">超市</text>{{product.title}}
    </view>
    <view class="price-row">
      <text class="price big"><text class="yen">¥</text>{{product.price}}</text>
    </view>
  </view>

  <view class="card rows">
    <view class="kv" bindtap="openSku">
      <text class="k">已选</text>
      <text class="v ellipsis">默认规格</text>
      <text class="arrow">›</text>
    </view>
    <view class="kv">
      <text class="k">送至</text>
      <view class="vcol">
        <text class="v">江苏省常州金坛区东城街道中兴路(双俊检...</text>
        <text class="hint">有货 17:00前完成支付,预计(2026-08-19)发货</text>
        <text class="hint">预计1-5天送达(偏远地区除外)，具体送达时间以实际物流配送时间为准</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="kv">
      <text class="k">运费</text>
      <view class="vcol">
        <text class="v">免运费</text>
        <text class="hint">预计1-5天送达(偏远地区除外)，具体送达时间以实际物流配送时间为准</text>
      </view>
    </view>
  </view>

  <view class="rec-sec" id="rec">
    <view class="sec-t">商品推荐</view>
    <view class="grid">
      <view class="p-card" wx:for="{{rec}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image class="p-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="p-body">
          <view class="p-name ellipsis-2">{{item.title}}</view>
          <view class="p-foot">
            <text class="price"><text class="yen">¥</text>{{item.price}}</text>
            <view class="cart-fab" catchtap="addCart">
              <view class="cart-fab-icon"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="desc-sec" id="desc">
    <view class="sec-t">商品详情</view>
    <image class="desc-img" src="{{product.descImage || product.image}}" mode="widthFix"></image>
    <view class="desc-txt" wx:if="{{product.desc}}">{{product.desc}}</view>
  </view>

  <view class="bar">
    <view class="tools">
      <view class="tool" bindtap="goHome">
        <view class="ticon home"></view><text>客服</text>
      </view>
      <view class="tool" bindtap="goCart">
        <view class="ticon bag"></view><text>购物车</text>
      </view>
    </view>
    <view class="ghost" bindtap="addCart">加入购物车</view>
    <view class="fill" bindtap="openSku">立即购买</view>
  </view>

  <sku-popup
    show="{{skuShow}}"
    product="{{product}}"
    bind:close="closeSku"
    bind:confirm="onSkuConfirm"
  ></sku-popup>
</view>
