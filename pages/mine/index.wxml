<view class="page mine">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="blob b1"></view>
    <view class="blob b2"></view>
    <view class="user">
      <image wx:if="{{loggedIn && user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
      <image wx:else class="avatar" src="/images/icons/guest.png" mode="aspectFill"></image>
      <view class="uinfo">
        <view class="nick">{{user.nickname}}</view>
        <view class="phone">{{user.phone}}</view>
      </view>
      <view class="bind-btn" bindtap="goBind">
        <image class="star-ic" src="/images/icons/star-gold.png" mode="aspectFit"></image>
        <text>积分绑定</text>
        <text class="caret">›</text>
      </view>
    </view>
  </view>

  <view class="welfare" bindtap="goWelfare">
    <view>
      <view class="w-title">
        <image class="w-mark" src="/images/icons/welfare-mark.png" mode="aspectFit"></image>
        <text>我的福利  {{welfareCount}}</text>
      </view>
      <view class="w-sub">各项福利享不停，立即查看我的福利</view>
    </view>
    <image class="flower" src="/images/icons/flower.png" mode="aspectFit"></image>
  </view>

  <view class="card order-card">
    <view class="card-hd">
      <text>我的订单</text>
      <text class="all" bindtap="goOrders">全部订单 ›</text>
    </view>
    <view class="order-icons">
      <view class="oi" bindtap="goOrders"><image class="oi-ic" src="/images/icons/order-film.png" mode="aspectFit"></image><text>电影</text></view>
      <view class="oi" bindtap="goOrders"><image class="oi-ic" src="/images/icons/order-vip.png" mode="aspectFit"></image><text>会员</text></view>
      <view class="oi" bindtap="goOrders"><image class="oi-ic" src="/images/icons/order-bag.png" mode="aspectFit"></image><text>商品</text></view>
      <view class="oi" bindtap="goOrders"><image class="oi-ic" src="/images/icons/order-cake.png" mode="aspectFit"></image><text>蛋糕</text></view>
      <view class="oi" bindtap="goOrders"><image class="oi-ic" src="/images/icons/order-food.png" mode="aspectFit"></image><text>点餐</text></view>
    </view>
  </view>

  <view class="card menu-card">
    <view class="menu" bindtap="goAddress">
      <image class="mi" src="/images/icons/menu-pin.png" mode="aspectFit"></image><text>收货地址</text><text class="arrow">›</text>
    </view>
    <view class="menu" bindtap="goProfile">
      <image class="mi" src="/images/icons/menu-profile.png" mode="aspectFit"></image><text>个人资料</text><text class="arrow">›</text>
    </view>
    <view class="menu" bindtap="goService">
      <image class="mi" src="/images/icons/menu-chat.png" mode="aspectFit"></image><text>联系客服</text><text class="arrow">›</text>
    </view>
    <view class="menu" bindtap="goFeedback">
      <image class="mi" src="/images/icons/menu-mail.png" mode="aspectFit"></image><text>意见反馈</text><text class="arrow">›</text>
    </view>
    <view class="menu" bindtap="goAbout">
      <image class="mi" src="/images/icons/menu-info.png" mode="aspectFit"></image><text>关于我们</text><text class="arrow">›</text>
    </view>
  </view>

  <c-modal
    show="{{guestShow}}"
    title="游客模式暂不支持该功能"
    cancelText="继续体验"
    confirmText="去注册/登录"
    bind:cancel="onStay"
    bind:close="onStay"
    bind:confirm="onGoLogin"
  >
    <view>绑定新卡完成注册或登录可使用完整功能</view>
  </c-modal>
</view>
