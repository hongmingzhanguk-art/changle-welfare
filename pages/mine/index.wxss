.mine {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #D8D4FF 0%, #EDEAFF 50%, var(--bg) 100%);
  padding-bottom: var(--space-3);
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
}
.b1 { width: 400rpx; height: 400rpx; right: -80rpx; top: -80rpx; }
.b2 { width: 240rpx; height: 240rpx; left: -80rpx; top: var(--space-5); }

.user {
  display: flex;
  align-items: center;
  padding: 48rpx var(--space-4) var(--space-3);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #eee;
}
.uinfo { flex: 1; margin-left: var(--space-3); min-width: 0; }
.nick { font-size: 36rpx; font-weight: var(--fw-display); }
.phone { font-size: var(--fs-caption); color: var(--sub); margin-top: var(--space-1); }
.bind-btn {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 32rpx;
  padding: 0 var(--space-2);
  min-height: var(--hit);
  font-size: var(--fs-caption);
  box-shadow: 0 4rpx 12rpx rgba(80,70,180,0.08);
}
.star-ic { width: 32rpx; height: 32rpx; margin-right: 6rpx; }
.caret { color: var(--icon); margin-left: 6rpx; }

.welfare {
  margin: 0 var(--space-3) var(--space-3);
  background: linear-gradient(90deg, #3A1A7A, #5B2AA8 50%, #3A1A7A);
  border-radius: var(--radius);
  padding: 28rpx 28rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  position: relative;
  min-height: var(--hit);
}
.w-title {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  display: flex;
  align-items: center;
}
.w-mark {
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--space-1);
}
.w-sub { font-size: var(--fs-caption); opacity: 0.8; margin-top: var(--space-1); }
.flower {
  width: 160rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.card {
  margin: 0 var(--space-3) var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3);
}
.card-hd {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  margin-bottom: var(--space-3);
}
.all { font-size: var(--fs-caption); color: var(--sub); font-weight: 400; min-height: var(--hit); display: flex; align-items: center; }
.order-icons { display: flex; }
.oi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--text);
  min-height: var(--hit);
}
.oi-ic {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 10rpx;
}

.menu {
  display: flex;
  align-items: center;
  padding: 0;
  min-height: var(--hit);
  font-size: var(--fs-title);
  border-bottom: 1rpx solid #F6F6F8;
}
.menu:last-child { border-bottom: none; }
.mi {
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.arrow { margin-left: auto; color: var(--icon); font-size: var(--fs-title); }
