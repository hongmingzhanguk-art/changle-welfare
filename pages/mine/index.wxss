.mine {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #F4F5F9;
}
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #D8D4FF 0%, #EDEAFF 50%, #F4F5F9 100%);
  padding-bottom: 24rpx;
}
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.35);
}
.b1 { width: 400rpx; height: 400rpx; right: -80rpx; top: -80rpx; }
.b2 { width: 240rpx; height: 240rpx; left: -80rpx; top: 40rpx; }

.user {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #eee;
}
.guest-av {
  background: #D8D8E0;
  position: relative;
}
.guest-av::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 28%;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  background: #fff;
  border-radius: 50%;
}
.uinfo { flex: 1; margin-left: 20rpx; min-width: 0; }
.nick { font-size: 36rpx; font-weight: 700; }
.phone { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.bind-btn {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(80,70,180,0.08);
}
.star { color: #F5B400; margin-right: 6rpx; }
.caret { color: #C0C0C8; margin-left: 6rpx; }

.welfare {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(90deg, #3A1A7A, #5B2AA8 50%, #3A1A7A);
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
  position: relative;
}
.w-title { font-size: 32rpx; font-weight: 700; }
.w-sub { font-size: 22rpx; opacity: 0.8; margin-top: 8rpx; }
.flower {
  width: 140rpx;
  height: 100rpx;
  background: radial-gradient(circle at 30% 40%, #C9B6FF, transparent 50%),
    radial-gradient(circle at 70% 50%, #8B6CFF, transparent 50%);
  opacity: 0.9;
}

.card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}
.card-hd {
  display: flex;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.all { font-size: 24rpx; color: #999; font-weight: 400; }
.order-icons { display: flex; }
.oi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #333;
}
.oi-ic {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 10rpx;
  border: 4rpx solid #222;
  border-radius: 12rpx;
}
.oi-ic.film { border-radius: 8rpx; }
.oi-ic.vip { border-radius: 8rpx 8rpx 16rpx 16rpx; }
.oi-ic.bag { border-radius: 8rpx 8rpx 16rpx 16rpx; }
.oi-ic.cake { border-radius: 12rpx 12rpx 8rpx 8rpx; }
.oi-ic.food { border-radius: 50% 50% 12rpx 12rpx; }

.menu {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  border-bottom: 1rpx solid #F6F6F8;
}
.menu:last-child { border-bottom: none; }
.mi {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  margin-right: 18rpx;
}
.mi.loc { background: #4C8DFF; }
.mi.user { background: #4C6FFF; }
.mi.chat { background: #22C55E; }
.mi.mail { background: #FF5A7A; }
.mi.info { background: #FFB020; }
.arrow { margin-left: auto; color: #C8C8D0; font-size: 32rpx; }
