.mine {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}
.hero-bg {
  height: 700rpx;
}
.hero {
  position: relative;
  z-index: 1;
  padding-bottom: 0;
}
.order-card,
.menu-card {
  position: relative;
  z-index: 1;
}

.user {
  display: flex;
  align-items: flex-end;
  padding: 108rpx var(--space-4) 32rpx;
}
.user-hit {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: var(--hit);
}
.user-hit-on { opacity: 0.72; }
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid var(--on-inverse);
  background: var(--fill);
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(101, 125, 173, 0.25);
}
.uinfo { flex: 1; margin-left: var(--space-3); min-width: 0; }
.nick { font-size: 36rpx; font-weight: 500; }
.phone { font-size: var(--fs-body); color: #757F99; margin-top: var(--space-1); }
.bind-hit {
  flex-shrink: 0;
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.bind-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 24rpx;
  width: 232rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  font-size: var(--fs-body);
  color: #404F73;
  box-shadow: 0 4rpx 16rpx rgba(101, 125, 173, 0.25);
}
.star-ic { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.caret-ic {
  width: 8rpx;
  height: 16rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.welfare {
  margin: 0 var(--space-3) 0;
  background: #3F027B;
  border-radius: var(--radius);
  padding: 28rpx 28rpx;
  color: var(--on-inverse);
  overflow: hidden;
  position: relative;
  height: 132rpx;
  box-sizing: border-box;
}
.welfare-bg {
  height: 132rpx;
}
.w-title {
  font-size: 32rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
}
.w-mark {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.w-name,
.w-count {
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
  background: linear-gradient(90deg, #F8CFCD 0%, #FFF6E9 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.w-count { margin-left: 20rpx; }
.w-sub { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-top: 16rpx; }

.card {
  margin: var(--space-3);
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-3);
}
.card-hd {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  margin-bottom: var(--space-3);
}
.all {
  font-size: var(--fs-caption);
  color: var(--sub);
  font-weight: 400;
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.order-icons { display: flex; }
.oi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--text);
  min-height: var(--hit);
}
.oi-ic {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
}

.menu {
  display: flex;
  align-items: center;
  padding: 0;
  min-height: var(--hit);
  font-size: var(--fs-title);
  border-bottom: 1rpx solid var(--line);
}
.menu:last-child { border-bottom: none; }
.mi {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.menu .caret-ic { margin-left: auto; }
