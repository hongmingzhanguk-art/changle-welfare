.mask {
  --bg: #F4F5F9;
  --card: #ffffff;
  --text: #1A1A1A;
  --sub: #6E6E7A;
  --primary: #6B5CFF;
  --primary-dark: #4D42B8;
  --grad: linear-gradient(90deg, #4C6FFF 0%, #8B5CFF 100%);
  --wash: #E6E0FF;
  --on-inverse: #ffffff;
  --overlay: rgba(0, 0, 0, 0.45);
  --fs-body: 28rpx;
  --fs-display: 40rpx;
  --fw-display: 700;
  --space-3: 24rpx;
  --space-5: 40rpx;
  --hit: 88rpx;
  --radius-pill: 44rpx;
  --shadow-cta: 0 8rpx 20rpx rgba(76, 111, 255, 0.28);
  position: fixed;
  inset: 0;
  background: var(--overlay);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.box {
  width: 100%;
  background: linear-gradient(180deg, var(--wash) 0%, var(--card) 28%);
  border-radius: 32rpx;
  padding: 48rpx var(--space-5) 36rpx;
}
.title {
  text-align: center;
  font-size: var(--fs-display);
  font-weight: var(--fw-display);
  margin-bottom: 28rpx;
}
.body {
  color: var(--sub);
  font-size: var(--fs-body);
  line-height: 1.7;
  text-align: center;
}
.actions {
  margin-top: var(--space-5);
  display: flex;
  gap: var(--space-3);
}
.btn {
  flex: 1;
  min-height: var(--hit);
  height: var(--hit);
  line-height: var(--hit);
  text-align: center;
  border-radius: var(--radius-pill);
  font-size: var(--fs-body);
  font-weight: 600;
}
.ghost {
  color: var(--primary);
  border: 2rpx solid var(--primary);
  background: var(--card);
}
.fill {
  color: var(--on-inverse);
  background: var(--grad);
  box-shadow: var(--shadow-cta);
  letter-spacing: 1rpx;
}
.btn-on {
  opacity: 0.88;
}
