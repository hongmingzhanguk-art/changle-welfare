<view class="wrap" wx:if="{{show}}" catchtouchmove="noop">
  <view class="mask" bindtap="onClose"></view>
  <view class="sheet">
    <view class="head">
      <text class="ht">规格选择</text>
      <view class="close" bindtap="onClose">
        <image class="close-ic" src="/images/icons/close.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="prod">
      <image class="thumb" src="{{preview || product.image}}" mode="aspectFill"></image>
      <view class="meta">
        <view class="name ellipsis">{{product.title}}</view>
        <view class="price"><text class="yen">¥</text>{{product.price}}</view>
        <view class="stepper">
          <view class="sbtn" bindtap="minus"><text class="sbtn-mark">−</text></view>
          <text class="snum">{{qty}}</text>
          <view class="sbtn" bindtap="plus"><text class="sbtn-mark">+</text></view>
        </view>
      </view>
    </view>
    <view class="spec" wx:for="{{product.sku.specs}}" wx:key="name">
      <view class="slabel">{{item.name}}</view>
      <view class="chips">
        <view
          class="chip {{selected[item.name] === v ? 'on' : ''}}"
          wx:for="{{item.values}}"
          wx:for-item="v"
          wx:key="*this"
          data-name="{{item.name}}"
          data-value="{{v}}"
          bindtap="pick"
        >{{v}}</view>
      </view>
    </view>
    <view class="cta">
      <view class="ghost" wx:if="{{mode === 'cart'}}" bindtap="addCart">加入购物车</view>
      <view class="buy" wx:if="{{mode === 'buy'}}" bindtap="buy">立即购买</view>
    </view>
  </view>
</view>
