.wrap {
  --bg: #F4F5F9;
  --card: #ffffff;
  --text: #1A1A1A;
  --sub: #6E6E7A;
  --primary: #6B5CFF;
  --primary-dark: #4D42B8;
  --price: #FF2A2A;
  --grad: linear-gradient(90deg, #4C6FFF 0%, #8B5CFF 100%);
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 40rpx;
  --fw-title: 600;
  --fw-display: 700;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --hit: 88rpx;
  position: fixed;
  inset: 0;
  z-index: 180;
}
.mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #F4F0FF 0%, #fff 80rpx);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx var(--space-4) calc(env(safe-area-inset-bottom) + var(--space-3));
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}
.ht {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
}
.close {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.close-ic {
  width: 32rpx;
  height: 32rpx;
}
.prod {
  display: flex;
  gap: var(--space-3);
  margin-bottom: 28rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--space-2);
  background: #f6f6f6;
}
.meta {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
}
.price {
  color: var(--price);
  font-size: var(--fs-display);
  font-weight: var(--fw-display);
  margin: var(--space-1) 0 var(--space-2);
}
.yen { font-size: var(--fs-caption); }
.stepper {
  display: flex;
  align-items: center;
}
.sbtn {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sbtn-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--space-1);
  background: #F3F4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  color: var(--sub);
}
.snum {
  min-width: 56rpx;
  text-align: center;
  font-size: var(--fs-body);
}
.spec { margin-bottom: var(--space-3); }
.slabel {
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  margin-bottom: var(--space-2);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.chip {
  padding: 12rpx 22rpx;
  background: #F3F4F8;
  border-radius: 12rpx;
  font-size: var(--fs-caption);
  color: var(--text);
  border: 2rpx solid transparent;
}
.chip.on {
  background: var(--card);
  color: var(--primary);
  border-color: var(--primary);
}
.cta { margin-top: 12rpx; }
.buy {
  height: var(--hit);
  line-height: var(--hit);
  text-align: center;
  color: #fff;
  font-size: var(--fs-title);
  border-radius: 44rpx;
  background: var(--grad);
}
.ghost {
  height: var(--hit);
  line-height: var(--hit);
  text-align: center;
  color: var(--primary);
  font-size: var(--fs-title);
  border-radius: 44rpx;
  border: 2rpx solid var(--primary);
  background: var(--card);
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
