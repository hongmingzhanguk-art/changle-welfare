.wrap {
  --bg: #F4F5F9;
  --card: #ffffff;
  --fill: #F3F4F8;
  --text: #1A1A1A;
  --sub: #6E6E7A;
  --primary: #6B5CFF;
  --primary-dark: #4D42B8;
  --price: #FF2A2A;
  --grad: linear-gradient(90deg, #4C6FFF 0%, #8B5CFF 100%);
  --wash: #E6E0FF;
  --on-inverse: #ffffff;
  --overlay: rgba(0, 0, 0, 0.45);
  --fs-caption: 22rpx;
  --fs-body: 28rpx;
  --fs-title: 32rpx;
  --fs-display: 40rpx;
  --fw-title: 600;
  --fw-display: 700;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --hit: 88rpx;
  --radius-pill: 44rpx;
  --shadow-cta: 0 8rpx 20rpx rgba(76, 111, 255, 0.28);
  position: fixed;
  inset: 0;
  z-index: 180;
}
.mask {
  position: absolute;
  inset: 0;
  background: var(--overlay);
}
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, var(--wash) 0%, var(--card) 80rpx);
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx var(--space-4) calc(env(safe-area-inset-bottom) + var(--space-3));
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}
.ht {
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
}
.close {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.close-ic {
  width: 20rpx;
  height: 20rpx;
}
.prod {
  display: flex;
  gap: var(--space-3);
  margin-bottom: 28rpx;
}
.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--space-2);
  background: var(--fill);
}
.meta {
  flex: 1;
  min-width: 0;
}
.name {
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
}
.price {
  color: var(--price);
  font-size: 24rpx;
  font-weight: var(--fw-title);
  margin: var(--space-1) 0 var(--space-2);
}
.yen { font-size: var(--fs-caption); }
.stepper {
  display: flex;
  align-items: center;
}
.sbtn {
  width: var(--hit);
  height: var(--hit);
  min-width: var(--hit);
  min-height: var(--hit);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sbtn-mark {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--space-1);
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  color: var(--sub);
}
.snum {
  min-width: 56rpx;
  text-align: center;
  font-size: var(--fs-body);
}
.spec { margin-bottom: var(--space-3); }
.slabel {
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  margin-bottom: var(--space-2);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.chip-hit {
  min-height: var(--hit);
  display: flex;
  align-items: center;
}
.chip {
  padding: 0 var(--space-3);
  height: 64rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  background: var(--fill);
  border-radius: 12rpx;
  font-size: var(--fs-caption);
  color: var(--text);
  border: 2rpx solid transparent;
}
.chip.on {
  background: var(--card);
  color: var(--primary);
  border-color: var(--primary);
}
.cta { margin-top: 12rpx; }
.buy {
  height: 100rpx;
  min-height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  color: var(--on-inverse);
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  letter-spacing: 1rpx;
  border-radius: var(--radius-pill);
  background: var(--grad);
  box-shadow: var(--shadow-cta);
}
.ghost {
  height: 100rpx;
  min-height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  color: var(--primary);
  font-size: var(--fs-body);
  font-weight: var(--fw-title);
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--primary);
  background: var(--card);
}
.btn-on {
  opacity: 0.88;
}
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
