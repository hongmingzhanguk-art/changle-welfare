.navbar {
  --fs-title: 32rpx;
  --fw-title: 600;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
}
.inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}
.left {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.back-ic {
  width: 36rpx;
  height: 36rpx;
}
.title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  pointer-events: none;
}
